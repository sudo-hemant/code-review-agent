# Copy this file to .env and fill it in. .env is never committed.

# Your Gemini key, from https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Which model to review with. Leave it out to use the default.
# Examples:
#   google_genai:gemini-3.8-flash   free Gemini model (default)
#   ollama:qwen2.5-coder:3b         a model running on your own Mac
#   anthropic:claude-opus-5         paid, for when quality matters
# REVIEW_MODEL=google_genai:gemini-3.8-flash
